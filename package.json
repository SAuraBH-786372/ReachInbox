{
  "name": "reachinbox-scheduler-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade Email Job Scheduler with BullMQ, Redis, PostgreSQL, Elasticsearch, Express, and Next.js",
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"cross-env NODE_OPTIONS=--max-old-space-size=2048 npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:studio": "npm run db:studio --workspace=backend",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f"
  },
  "keywords": [
    "reachinbox",
    "email-scheduler",
    "bullmq",
    "redis",
    "prisma",
    "postgresql",
    "elasticsearch",
    "nextjs",
    "express"
  ],
  "author": "ReachInbox",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0"
  }
}
