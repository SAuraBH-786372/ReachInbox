# ─── Production Environment Variables ──────────────────────────────────────────
# Copy this file and fill in the values in the Render dashboard
# (Environment → Add Environment Variable for each service)
# DO NOT commit real secrets to git.

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── CORS / Frontend ───────────────────────────────────────────────────────────
# Set to your deployed frontend URL (from Render dashboard)
CORS_ORIGIN=https://reachinbox-frontend.onrender.com
FRONTEND_URL=https://reachinbox-frontend.onrender.com

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
# Auto-populated by Render when using the Blueprint.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://reachinbox:CHANGEME@RENDER_HOST:5432/reachinbox_db

# ─── Redis ─────────────────────────────────────────────────────────────────────
# Auto-populated by Render when using the Blueprint.
# Render Redis connection string includes credentials.
REDIS_URL=rediss://CHANGEME@RENDER_REDIS_HOST:6379
REDIS_TLS=true

# ─── Elasticsearch ─────────────────────────────────────────────────────────────
# Use Bonsai (https://bonsai.io) — free tier available.
# The Bonsai URL already contains auth credentials in the URL.
ELASTICSEARCH_NODE=https://USER:PASSWORD@your-cluster.bonsai.io
ELASTICSEARCH_INDEX=reachinbox_email_jobs
# Only needed if you separate auth from the URL:
# ELASTICSEARCH_USERNAME=your-username
# ELASTICSEARCH_PASSWORD=your-password

# ─── Session ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Render can auto-generate this with generateValue: true in render.yaml
SESSION_SECRET=CHANGEME_32_char_hex_secret

# ─── Google OAuth ──────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
# Must exactly match what you registered in Google Console
GOOGLE_CALLBACK_URL=https://reachinbox-backend.onrender.com/api/auth/google/callback

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGEME_jwt_secret

# ─── BullMQ Worker ─────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=3
MIN_DELAY_SECONDS=2

# ─── Slack (optional) ──────────────────────────────────────────────────────────
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=https://reachinbox-backend.onrender.com/api/slack/oauth/callback
